-- ADVANCED AIMBOT LOGIC
--========================================================

local lastHealth = 100
local currentTarget = nil

local function validTarget(target)
	if not target or target == player then return false end
	if player.Team and target.Team and player.Team == target.Team then return false end
	
	local character = target.Character
	if not character then return false end
	
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local head = character:FindFirstChild("Head")
	local myCharacter = player.Character
	local myRoot = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")

	if not humanoid or humanoid.Health <= 0 or not head or not myRoot then return false end
	return (head.Position - myRoot.Position).Magnitude <= MAX_DISTANCE
end

local function getBestTarget()
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then return nil end
	
	local camera = workspace.CurrentCamera
	if not camera then return nil end
	
	local bestTarget = nil
	local bestScore = -math.huge
	
	for _, target in ipairs(Players:GetPlayers()) do
		if validTarget(target) then
			local head = target.Character:FindFirstChild("Head")
			if head then
				local distance = (head.Position - root.Position).Magnitude
				
				local screenPos, onScreen = camera:WorldToViewportPoint(head.Position)
				if onScreen then
					local fovDistance = math.sqrt((screenPos.X - camera.ViewportSize.X/2)^2 + (screenPos.Y - camera.ViewportSize.Y/2)^2)
					
					if fovDistance <= fovSize then
						local score = 0
						score = score + (MAX_DISTANCE - distance) * 10
						score = score + (fovSize - fovDistance) * 5
						
						local humanoid = target.Character:FindFirstChildOfClass("Humanoid")
						if humanoid then
							score = score + (100 - humanoid.Health) * 2
						end
						
						if currentTarget == target then
							score = score + 50
						end
						
						if score > bestScore then
							bestScore = score
							bestTarget = target
						end
					end
				end
			end
		end
	end
	
	return bestTarget
end

local function getPredictedPosition(target)
	local head = target.Character:FindFirstChild("Head")
	if not head then return nil end
	
	local humanoid = target.Character:FindFirstChildOfClass("Humanoid")
	if not humanoid then return head.Position end
	
	local currentPos = head.Position
	local predictedPos = currentPos + (humanoid.MoveDirection * 0.3)
	
	return predictedPos
end

task.spawn(function()
	while true do
		task.wait(0.05)
		local myCharacter = player.Character
		if not myCharacter then 
			task.wait(0.5)
			lastHealth = 100
			continue 
		end
		
		local myHumanoid = myCharacter:FindFirstChildOfClass("Humanoid")
		if not myHumanoid then 
			task.wait(0.5)
			continue 
		end
		
		local currentHealth = myHumanoid.Health
		if currentHealth < lastHealth then
			local attacker = nil
			local shortestDist = MAX_DISTANCE
			local myRoot = myCharacter:FindFirstChild("HumanoidRootPart")
			
			if myRoot then
				for _, target in ipairs(Players:GetPlayers()) do
					if validTarget(target) then
						local tRoot = target.Character:FindFirstChild("HumanoidRootPart")
						if tRoot then
							local dist = (tRoot.Position - myRoot.Position).Magnitude
							if dist < shortestDist then
								shortestDist = dist
								attacker = target
							end
						end
					end
				end
			end
			
			if attacker then
				currentTarget = attacker
				lockedTarget = attacker
			end
		end
		lastHealth = currentHealth
	end
end)

RunService.RenderStepped:Connect(function()
	if not aimEnabled then return end

	local target = getBestTarget()
	
	if target then
		currentTarget = target
		lockedTarget = target
		
		local character = target.Character
		if not character then 
			currentTarget = nil
			lockedTarget = nil
			return 
		end
		
		local head = character:FindFirstChild("Head")
		local camera = workspace.CurrentCamera

		if head and camera then
			local aimPosition = head.Position
			
			if predictionEnabled then
				local predicted = getPredictedPosition(target)
				if predicted then
					aimPosition = predicted
				end
			end
			
			local currentCFrame = camera.CFrame
			local targetCFrame = CFrame.new(currentCFrame.Position, aimPosition)
			
			local humanoid = character:FindFirstChildOfClass("Humanoid")
			local speedFactor = 0
			if humanoid then
				speedFactor = humanoid.WalkSpeed / 16
			end
			
			local adaptiveAlpha = math.clamp((101 - smoothness) / 100 + speedFactor * 0.1, 0.05, 0.9)
			
			camera.CFrame = currentCFrame:Lerp(targetCFrame, adaptiveAlpha)
		end
	else
		currentTarget = nil
		if not lockedTarget or not validTarget(lockedTarget) then
			lockedTarget = nil
		end
	end
end)

